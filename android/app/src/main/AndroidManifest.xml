<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permisos requeridos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sonido del pedido EN BUCLE con la app minimizada (23-jul-2026): foreground service
         tipo shortService (tarea corta <=3 min). No requiere permiso de tipo específico
         más allá de FOREGROUND_SERVICE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- v300 (2-ago-2026): PresenceBeatService late cada 60s como foreground service tipo
         location (Android 14+ exige declarar el permiso del tipo). El plugin de
         background-geolocation ya lo aporta por manifest-merge; se declara explícito
         porque nuestro servicio propio también lo usa. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Geolocation. Primer plano: ACCESS_FINE/COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ubicación en SEGUNDO PLANO (v273): el rider comparte su GPS con la app
         minimizada / pantalla apagada mientras está "En servicio", para que el
         dispatcher le asigne pedidos por cercanía aunque no tenga la app delante.
         El plugin @capacitor-community/background-geolocation aporta el <service>
         (foregroundServiceType=location) + FOREGROUND_SERVICE + FOREGROUND_SERVICE_LOCATION
         vía manifest merge; aquí solo declaramos el permiso sensible de Android 10+.
         Disclosure mostrado en la app antes de pedir el permiso (LocationDisclosureModal). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Push notifications + interacción al recibirla -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exención de optimización de batería: que el SO no mate el proceso en segundo plano
         mientras el socio está EN SERVICIO (Parte B). Se pide vía ajustes, no prompt directo. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link OAuth (no usado por ahora, login email/password) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.pidoo.socio" />
            </intent-filter>
        </activity>

        <!-- FCM: canal por defecto para pedidos -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pedidos_alarma_v1"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary"
        />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Servicio que detecta el cierre de la app (onTaskRemoved) -> offline instantáneo.
             stopWithTask=false es lo que garantiza que se llame a onTaskRemoved. -->
        <service
            android:name=".OfflineBeaconService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- v300 (2-ago-2026): LATIDO NATIVO DE PRESENCIA. Foreground service (type location)
             que late cada 60s en Java con la llave de presencia — inmune a la congelación
             del WebView que dejaba al socio "En línea" pero mudo (caso Edinson/Misael).
             stopWithTask=false para que onTaskRemoved mande el offline al cerrar la app. -->
        <service
            android:name=".PresenceBeatService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <!-- 23-jul-2026: SONIDO EN BUCLE del pedido con la app minimizada.
             1) Nuestro MessagingService (extiende el de Capacitor) intercepta el push de
                asignación y arranca la alarma en bucle si la app está en segundo plano. -->
        <service
            android:name=".PidooMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Quitamos el MessagingService del plugin de Capacitor: FCM entrega solo al nuestro
             (que llama a super, preservando el reenvío al JS y el registro de token). -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- 2) Foreground service que reproduce el sonido en bucle (shortService, <=150 s). -->
        <service
            android:name=".PedidoAlarmService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
